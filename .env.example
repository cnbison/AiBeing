# OpenHer Environment Variables
# Copy this file to .env and fill in your API keys

# LLM Provider
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DEFAULT_MODEL=qwen3-max
DEFAULT_PROVIDER=dashscope

# Optional: OpenAI (for GPT-4o)
# OPENAI_API_KEY=your_openai_api_key_here

# EverMemOS Long-Term Memory
# Cloud mode (recommended): EVEROS_API_KEY + EVERMEMOS_BASE_URL=https://api.evermind.ai
# Self-hosted mode: EVERMEMOS_BASE_URL=http://localhost:1995/api/v1 (no API key needed)
EVERMEMOS_BASE_URL=http://localhost:1995/api/v1
# EVEROS_API_KEY=your_everos_api_key_here  # Cloud mode only
